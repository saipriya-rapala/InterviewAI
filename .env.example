# OpenAI API Key (Required for live voice interview evaluations & speech feedback)
OPENAI_API_KEY=your_openai_api_key_here

# JWT Secret (Base64-encoded secret key used for authentication tokens)
JWT_SECRET=dGhpc19pc19hX3Zlcnlfc2VjdXJlX2tleV9mb3JfaW50ZXJ2aWV3YWlfMzJieXRlcw==

# Database Password (Optional: Leave empty for default embedded in-memory H2 database)
DB_PASSWORD=

# Application Server Port (Default: 8081)
SERVER_PORT=8081
