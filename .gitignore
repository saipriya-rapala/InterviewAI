# ==========================================
# InterviewAI Root .gitignore
# ==========================================

# Secrets and Sensitive Environment Files (CRITICAL)
.env
.env.*
!.env.example
*.local
*.pem
*.key

# Frontend dependencies & build artifacts
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Backend Maven & Java build artifacts
backend/target/
backend/.env
backend/private-resumes/
backend/data/
*.db
backend/.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# IDE and Editor files
.idea/
.vscode/
*.iml
*.iws
*.ipr
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache
.DS_Store
Thumbs.db
